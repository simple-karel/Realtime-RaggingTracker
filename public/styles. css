/* Enhanced Futuristic UI - Professional Design */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Orbitron:wght@500;700&display=swap');

:root {
  --primary: #00e6ff;
  --primary-dark: #008cff;
  --secondary: #7b2dff;
  --dark-bg: #0a0e17;
  --mid-bg: #131b2e;
  --light-text: #e6f0ff;
  --mid-text: #a9b8d3;
  --accent: #ff2d8d;
}

body {
  margin: 0;
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(135deg, var(--dark-bg), var(--mid-bg));
  color: var(--light-text);
  min-height: 100vh;
  background-attachment: fixed;
  position: relative;
  overflow-x: hidden;
}

