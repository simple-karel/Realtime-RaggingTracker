body {
  margin: 0;
  font-family: 'Arial', sans-serif;
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  color: #e0e0e0;
  min-height: 100vh;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

h1 {
  text-align: center;
  font-size: 2.5em;
  color: #00ffcc;
  text-shadow: 0 0 10px #00ffcc;
  animation: glow 2s ease-in-out infinite alternate;
}

p {
  text-align: center;
  font-size: 1.2em;
  color: #b0b0b0;
}

.form-section, .search-section, .analytics-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
  padding: 20px;
  margin: 20px 0;
  box-shadow: 0 0 20px rgba(0, 255, 204, 0.2);
}

h2 {
  color: #00ffcc;
  font-size: 1.8em;
}

select, input, textarea, button {
  display: block;
  width: 100%;
  padding: 10px;
  margin: 10px 0;
  border: 1px solid #00ffcc;
  border-radius: 5px;
  background: rgba(255, 255, 255, 0.1);
  color: #e0e0e0;
  font-size: 1em;
  transition: all 0.3s ease;
}

select:focus, input:focus, textarea:focus {
  outline: none;
  box-shadow: 0 0 10px #00ffcc;
}

button {
  background: #00ffcc;
  color: #1a1a2e;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: #00ccaa;
  box-shadow: 0 0 15px #00ffcc;
}

.chart-container {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
}

canvas {
  max-width: 48%;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
  padding: 10px;
}

#searchResults {
  margin-top: 20px;
  color: #e0e0e0;
}

@keyframes glow {
  from {
    text-shadow: 0 0 5px #00ffcc, 0 0 10px #00ffcc;
  }
  to {
    text-shadow: 0 0 10px #00ffcc, 0 0 20px #00ffcc;
  }
}

@media (max-width: 768px) {
  canvas {
    max-width: 100%;
    margin-bottom: 20px;
  }
}
